pi-machine"><mxGeometry x="15" y="85" width="120" height="24" as="geometry" /></mxCell><mxCell id="order_api-led2" value="" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=20;fontColor=#334155;ellipse;fillColor=#5F927B;strokeColor=none;" vertex="1" parent="order_api-rack2"><mxGeometry x="10" y="7" width="10" height="10" as="geometry" /></mxCell><mxCell id="order_api-slot2" value="" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=20;fontColor=#334155;shape=line;strokeColor=#94A3B8;strokeWidth=2;" vertex="1" parent="order_api-rack2"><mxGeometry x="35" y="12" width="63" height="1" as="geometry" /></mxCell><mxCell id="order_api-caption" value="Order API" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=20;fontColor=#334155;text;fillColor=none;strokeColor=none;align=center;verticalAlign=middle;fontSize=22;fontColor=#334155;fontSize=23;fontStyle=1;" vertex="1" parent="order_api"><mxGeometry x="0" y="170" width="220" height="34" as="geometry" /></mxCell><mxCell id="order_api-subtitle" value="Create pending order" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=22;fontColor=#243E53;text;fillColor=none;strokeColor=none;align=center;verticalAlign=middle;fontSize=17;fontStyle=0;fontColor=#6E8291;" vertex="1" parent="order_api"><mxGeometry x="0" y="208" width="220" height="29" as="geometry" /></mxCell><object id="reserve_stock" label="" tooltip="Reserve inventory before capturing payment. A failed hold rejects the order; a payment decline releases an existing hold."><mxCell style="group;" vertex="1" parent="1"><mxGeometry x="770" y="230" width="220" height="240" as="geometry" /></mxCell></object><mxCell id="reserve_stock-caption" value="Reserve inventory" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=20;fontColor=#334155;text;fillColor=none;strokeColor=none;align=center;verticalAlign=middle;fontSize=22;fontColor=#334155;fontSize=23;fontStyle=1;" vertex="1" parent="reserve_stock"><mxGeometry x="0" y="170" width="220" height="34" as="geometry" /></mxCell><mxCell id="reserve_stock-subtitle" value="Hold items with a TTL" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=22;fontColor=#243E53;text;fillColor=none;strokeColor=none;align=center;verticalAlign=middle;fontSize=17;fontStyle=0;fontColor=#6E8291;" vertex="1" parent="reserve_stock"><mxGeometry x="0" y="208" width="220" height="29" as="geometry" /></mxCell><object id="capture_payment" label="" tooltip="Illustrative policy: capture payment only after stock is reserved. A declined capture releases the hold; final fulfillment failures can later require a refund."><mxCell style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=22;fontColor=#243E53;group;" vertex="1" parent="1"><mxGeometry x="1120" y="230" width="220" height="240" as="geometry" /></mxCell></object><mxCell id="payment-card" value="" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=22;fontColor=#243E53;rounded=1;arcSize=12;fillColor=#EAF1F8;strokeColor=#5D819E;strokeWidth=2;" vertex="1" parent="capture_payment"><mxGeometry x="25" y="20" width="170" height="110" as="geometry" /></mxCell><mxCell id="card-stripe" value="" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=22;fontColor=#243E53;rounded=1;arcSize=12;fillColor=#7798B0;strokeColor=#7798B0;strokeWidth=2;rounded=0;" vertex="1" parent="payment-card"><mxGeometry x="0" y="22" width="170" height="23" as="geometry" /></mxCell><mxCell id="card-digits" value="••••  4242" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=22;fontColor=#243E53;text;fillColor=none;strokeColor=none;align=center;verticalAlign=middle;fontSize=20;fontStyle=0;fontColor=#243E53;" vertex="1" parent="payment-card"><mxGeometry x="15" y="63" width="140" height="30" as="geometry" /></mxCell><mxCell id="capture_payment-caption" value="Capture payment" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=22;fontColor=#243E53;text;fillColor=none;strokeColor=none;align=center;verticalAlign=middle;fontSize=23;fontStyle=1;fontColor=#243E53;" vertex="1" parent="capture_payment"><mxGeometry x="0" y="170" width="220" height="34" as="geometry" /></mxCell><mxCell id="capture_payment-subtitle" value="Payment provider" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=22;fontColor=#243E53;text;fillColor=none;strokeColor=none;align=center;verticalAlign=middle;fontSize=17;fontStyle=0;fontColor=#6E8291;" vertex="1" parent="capture_payment"><mxGeometry x="0" y="208" width="220" height="29" as="geometry" /></mxCell><object id="commit_order" label="" tooltip="After payment capture, update the order to CONFIRMED and persist OrderConfirmed in an outbox atomically. The relay publishes committed outbox records."><mxCell style="group;" vertex="1" parent="1"><mxGeometry x="1470" y="230" width="220" height="240" as="geometry" /></mxCell></object><mxCell id="commit_order-store" value="" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=20;fontColor=#334155;shape=cylinder3;size=18;fillColor=#EAF3EE;strokeColor=#5F927B;strokeWidth=2;" vertex="1" parent="commit_order"><mxGeometry x="35" y="10" width="150" height="132" as="geometry" /></mxCell><mxCell id="commit_order-store-kind" value="ORDER&#10;+ EVENT" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=20;fontColor=#334155;text;fillColor=none;strokeColor=none;align=center;verticalAlign=middle;fontSize=25;fontColor=#5F927B;" vertex="1" parent="commit_order-store"><mxGeometry x="5" y="48" width="140" height="35" as="geometry" /></mxCell><mxCell id="commit_order-caption" value="Order + outbox" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=20;fontColor=#334155;text;fillColor=none;strokeColor=none;align=center;verticalAlign=middle;fontSize=22;fontColor=#334155;fontSize=23;fontStyle=1;" vertex="1" parent="commit_order"><mxGeometry x="0" y="170" width="220" height="34" as="geometry" /></mxCell><mxCell id="commit_order-subtitle" value="One atomic commit" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=22;fontColor=#243E53;text;fillColor=none;strokeColor=none;align=center;verticalAlign=middle;fontSize=17;fontStyle=0;fontColor=#6E8291;" vertex="1" parent="commit_order"><mxGeometry x="0" y="208" width="220" height="29" as="geometry" /></mxCell><object id="outbox_relay" label="" tooltip="Read committed outbox records and publish a durable event. Publication can be retried; consumers use idempotency keys to ignore duplicates."><mxCell style="group;" vertex="1" parent="1"><mxGeometry x="1820" y="230" width="220" height="240" as="geometry" /></mxCell></object><mxCell id="outbox_relay-caption" value="Outbox relay" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=20;fontColor=#334155;text;fillColor=none;strokeColor=none;align=center;verticalAlign=middle;fontSize=22;fontColor=#334155;fontSize=23;fontStyle=1;" vertex="1" parent="outbox_relay"><mxGeometry x="0" y="170" width="220" height="34" as="geometry" /></mxCell><mxCell id="outbox_relay-subtitle" value="Publish OrderConfirmed" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=22;fontColor=#243E53;text;fillColor=none;strokeColor=none;align=center;verticalAlign=middle;fontSize=17;fontStyle=0;fontColor=#6E8291;" vertex="1" parent="outbox_relay"><mxGeometry x="0" y="208" width="220" height="29" as="geometry" /></mxCell><object id="order_db" label="" tooltip="Stored data, not an active callback sender. Rename the store and show the supported read/write direction."><mxCell style="group;" vertex="1" parent="1"><mxGeometry x="420" y="570" width="220" height="240" as="geometry" /></mxCell></object><mxCell id="order_db-store" value="" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=20;fontColor=#334155;shape=cylinder3;size=18;fillColor=#EAF3EE;strokeColor=#5F927B;strokeWidth=2;" vertex="1" parent="order_db"><mxGeometry x="35" y="10" width="150" height="132" as="geometry" /></mxCell><mxCell id="order_db-store-kind" value="ORDER DB" style="whiteSpace=wrap;fontFamily=Helvetica;fontSize=20;fontColor=#334155;text;fillColor=none;strokeColor=none;align=center;verticalAlign=middle;fontSize=25;fontColor=#5F927B;html=0;" vertex="1" parent="order_db-store"><mxGeometry x="5" y="48" width="140" height="35" as="geometry" /></mxCell><mxCell id="order_db-caption" value="Order store" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=20;fontColor=#334155;text;fillColor=none;strokeColor=none;align=center;verticalAlign=middle;fontSize=22;fontColor=#334155;fontSize=23;fontStyle=1;" vertex="1" parent="order_db"><mxGeometry x="0" y="170" width="220" height="34" as="geometry" /></mxCell><mxCell id="order_db-subtitle" value="Pending / confirmed" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=22;fontColor=#243E53;text;fillColor=none;strokeColor=none;align=center;verticalAlign=middle;fontSize=17;fontStyle=0;fontColor=#6E8291;" vertex="1" parent="order_db"><mxGeometry x="0" y="208" width="220" height="29" as="geometry" /></mxCell><object id="cancelled" label="" tooltip="A stock failure rejects checkout. A declined payment releases any stock hold. Neither path reaches fulfillment."><mxCell style="group;" vertex="1" parent="1"><mxGeometry x="1470" y="570" width="220" height="240" as="geometry" /></mxCell></object><mxCell id="cancelled-device" value="" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=20;fontColor=#334155;rounded=1;arcSize=10;fillColor=#F3F8F5;strokeColor=#94A3B8;strokeWidth=2;" vertex="1" parent="cancelled"><mxGeometry x="57" y="0" width="106" height="147" as="geometry" /></mxCell><mxCell id="cancelled-state" value="×" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=20;fontColor=#334155;ellipse;fillColor=#BD7869;strokeColor=none;fontColor=#FFFFFF;fontSize=42;" vertex="1" parent="cancelled-device"><mxGeometry x="21" y="34" width="64" height="64" as="geometry" /></mxCell><mxCell id="cancelled-home" value="" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=20;fontColor=#334155;shape=line;strokeColor=#94A3B8;strokeWidth=2;" vertex="1" parent="cancelled-device"><mxGeometry x="40" y="132" width="25" height="1" as="geometry" /></mxCell><mxCell id="cancelled-caption" value="Order cancelled" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=20;fontColor=#334155;text;fillColor=none;strokeColor=none;align=center;verticalAlign=middle;fontSize=22;fontColor=#334155;fontSize=23;fontStyle=1;" vertex="1" parent="cancelled"><mxGeometry x="0" y="170" width="220" height="34" as="geometry" /></mxCell><mxCell id="cancelled-subtitle" value="Payment declined" style="whiteSpace=wrap;fontFamily=Helvetica;fontSize=22;fontColor=#243E53;text;fillColor=none;strokeColor=none;align=center;verticalAlign=middle;fontSize=17;fontStyle=0;fontColor=#6E8291;html=0;" vertex="1" parent="cancelled"><mxGeometry x="0" y="208" width="220" height="29" as="geometry" /></mxCell><object id="release_hold" label="" tooltip="Compensation for a declined payment: release the reserved items before cancelling the order."><mxCell style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=22;fontColor=#243E53;group;" vertex="1" parent="1"><mxGeometry x="1120" y="570" width="220" height="240" as="geometry" /></mxCell></object><mxCell id="hold-box" value="" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=22;fontColor=#243E53;rounded=1;arcSize=12;fillColor=#F4E9D2;strokeColor=#BE9346;strokeWidth=2;" vertex="1" parent="release_hold"><mxGeometry x="40" y="25" width="140" height="110" as="geometry" /></mxCell><mxCell id="release-symbol" value="↩" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=22;fontColor=#243E53;text;fillColor=none;strokeColor=none;align=center;verticalAlign=middle;fontSize=54;fontStyle=0;fontColor=#BE9346;" vertex="1" parent="hold-box"><mxGeometry x="12" y="17" width="115" height="72" as="geometry" /></mxCell><mxCell id="release_hold-caption" value="Release stock hold" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=22;fontColor=#243E53;text;fillColor=none;strokeColor=none;align=center;verticalAlign=middle;fontSize=23;fontStyle=1;fontColor=#243E53;" vertex="1" parent="release_hold"><mxGeometry x="0" y="170" width="220" height="34" as="geometry" /></mxCell><mxCell id="release_hold-subtitle" value="Payment declined" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=22;fontColor=#243E53;text;fillColor=none;strokeColor=none;align=center;verticalAlign=middle;fontSize=17;fontStyle=0;fontColor=#6E8291;" vertex="1" parent="release_hold"><mxGeometry x="0" y="208" width="220" height="29" as="geometry" /></mxCell><mxCell id="phase-2" value="02  ASYNCHRONOUS FULFILLMENT  ←  EVENT FAN-OUT" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=22;fontColor=#243E53;text;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;fontSize=24;fontStyle=1;fontColor=#243E53;" vertex="1" parent="1"><mxGeometry x="55" y="825" width="1250" height="40" as="geometry" /></mxCell><object id="event_queue" label="" tooltip="The event fans out to independent fulfillment and notification consumers. A notification does not wait for shipment. Drawn card counts are illustrative, not backlog metrics."><mxCell style="group;" vertex="1" parent="1"><mxGeometry x="1800" y="900" width="260" height="240" as="geometry" /></mxCell></object><mxCell id="event_queue-direction" value="IN → BUFFER → OUT" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=20;fontColor=#334155;text;fillColor=none;strokeColor=none;align=center;verticalAlign=middle;fontSize=18;fontColor=#334155;" vertex="1" parent="event_queue"><mxGeometry x="0" y="0" width="260" height="30" as="geometry" /></mxCell><mxCell id="event_queue-tray" value="" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=20;fontColor=#334155;rounded=1;arcSize=10;fillColor=#FCF6E8;strokeColor=#94A3B8;strokeWidth=2;" vertex="1" parent="event_queue"><mxGeometry x="0" y="40" width="260" height="84" as="geometry" /></mxCell><mxCell id="event_queue-card0" value="" style="html=1;whiteSpace=wrap