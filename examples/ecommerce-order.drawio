<?xml version='1.0' encoding='utf-8'?>
<mxfile host="app.diagrams.net"><diagram id="checkout-flow" name="Checkout &amp; fulfillment"><mxGraphModel page="1" pageWidth="2250" pageHeight="1930" background="#FFFFFF"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="From cart to doorstep" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=22;fontColor=#243E53;text;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;fontSize=38;fontStyle=1;fontColor=#243E53;" vertex="1" parent="1"><mxGeometry x="55" y="25" width="2100" height="58" as="geometry" /></mxCell><mxCell id="subtitle" value="An illustrated commerce workflow · stock holds, payment capture, durable events, retries and compensation" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=22;fontColor=#243E53;text;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;fontSize=22;fontStyle=0;fontColor=#6E8291;" vertex="1" parent="1"><mxGeometry x="55" y="90" width="2100" height="36" as="geometry" /></mxCell><mxCell id="phase-1" value="01  CHECKOUT  →  CONFIRMED ORDER" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=22;fontColor=#243E53;text;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;fontSize=24;fontStyle=1;fontColor=#243E53;" vertex="1" parent="1"><mxGeometry x="55" y="155" width="1250" height="40" as="geometry" /></mxCell><object id="checkout" label="" tooltip="The customer submits a cart and delivery address. This is a fictional example, not a production design or payment recommendation."><mxCell style="group;" vertex="1" parent="1"><mxGeometry x="70" y="230" width="220" height="240" as="geometry" /></mxCell></object><mxCell id="checkout-frame" value="" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=20;fontColor=#334155;rounded=1;arcSize=10;fillColor=#F8FAFC;strokeColor=#94A3B8;strokeWidth=2;" vertex="1" parent="checkout"><mxGeometry x="0" y="5" width="220" height="145" as="geometry" /></mxCell><mxCell id="checkout-dot0" value="" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=20;fontColor=#334155;ellipse;fillColor=#94A3B8;strokeColor=none;" vertex="1" parent="checkout-frame"><mxGeometry x="12" y="10" width="7" height="7" as="geometry" /></mxCell><mxCell id="checkout-dot1" value="" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=20;fontColor=#334155;ellipse;fillColor=#94A3B8;strokeColor=none;" vertex="1" parent="checkout-frame"><mxGeometry x="26" y="10" width="7" height="7" as="geometry" /></mxCell><mxCell id="checkout-dot2" value="" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=20;fontColor=#334155;ellipse;fillColor=#94A3B8;strokeColor=none;" vertex="1" parent="checkout-frame"><mxGeometry x="40" y="10" width="7" height="7" as="geometry" /></mxCell><mxCell id="checkout-caption" value="Customer checkout" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=20;fontColor=#334155;text;fillColor=none;strokeColor=none;align=center;verticalAlign=middle;fontSize=22;fontColor=#334155;fontSize=23;fontStyle=1;" vertex="1" parent="checkout"><mxGeometry x="0" y="170" width="220" height="34" as="geometry" /></mxCell><mxCell id="checkout-subtitle" value="Submit cart + address" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=22;fontColor=#243E53;text;fillColor=none;strokeColor=none;align=center;verticalAlign=middle;fontSize=17;fontStyle=0;fontColor=#6E8291;" vertex="1" parent="checkout"><mxGeometry x="0" y="208" width="220" height="29" as="geometry" /></mxCell><object id="order_api" label="" tooltip="Create an order ID, record an idempotency key and persist a pending order before orchestrating stock and payment."><mxCell style="group;" vertex="1" parent="1"><mxGeometry x="420" y="230" width="220" height="240" as="geometry" /></mxCell></object><mxCell id="order_api-machine" value="" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=20;fontColor=#334155;rounded=1;arcSize=10;fillColor=#EBF2F7;strokeColor=#94A3B8;strokeWidth=2;" vertex="1" parent="order_api"><mxG