<mxfile host="app.diagrams.net"><diagram id="procurement" name="构件复用验证 · 采购审批示例"><mxGraphModel page="1" pageWidth="1920" pageHeight="850" background="#FFFFFF"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="构件复用验证：采购审批到发货" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=20;fontColor=#334155;text;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;fontSize=34;" vertex="1" parent="1"><mxGeometry x="45" y="25" width="1800" height="55" as="geometry" /></mxCell><mxCell id="subtitle" value="虚构流程，用于验证可复用对象、分支、状态变化，以及目录之外的新对象；不是业务事实。" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=20;fontColor=#334155;text;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;fontSize=20;" vertex="1" parent="1"><mxGeometry x="45" y="90" width="1800" height="35" as="geometry" /></mxCell><object id="submit" label="" tooltip="Use for a real user interaction. Change the selected item and action; keep the backend operation in its owning lane."><mxCell style="group;" vertex="1" parent="1"><mxGeometry x="60" y="210" width="220" height="200" as="geometry" /></mxCell></object><mxCell id="submit-frame" value="" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=20;fontColor=#334155;rounded=1;arcSize=10;fillColor=#F8FAFC;strokeColor=#94A3B8;strokeWidth=2;" vertex="1" parent="submit"><mxGeometry x="0" y="5" width="220" height="145" as="geometry" /></mxCell><mxCell id="submit-dot0" value="" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=20;fontColor=#334155;ellipse;fillColor=#94A3B8;strokeColor=none;" vertex="1" parent="submit-frame"><mxGeometry x="12" y="10" width="7" height="7" as="geometry" /></mxCell><mxCell id="submit-dot1" value="" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=20;fontColor=#334155;ellipse;fillColor=#94A3B8;strokeColor=none;" vertex="1" parent="submit-frame"><mxGeometry x="26" y="10" width="7" height="7" as="geometry" /></mxCell><mxCell id="submit-dot2" value="" style="ht